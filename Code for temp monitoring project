LiquidCrystal lcd(12, 11, 5, 4, 3, 2);

// Component pins
const int tempPin = A0;
const int potPin = A1;
const int greenLED = 8;
const int redLED = 9;
const int buzzer = 10;

void setup() {
  pinMode(greenLED, OUTPUT);
  pinMode(redLED, OUTPUT);
  pinMode(buzzer, OUTPUT);

  lcd.begin(16, 2);
  lcd.print("Temperature");
  lcd.setCursor(0, 1);
  lcd.print("Monitoring...");
  delay(1500);
  lcd.clear();

  Serial.begin(9600);
}

void loop() {
  // Read TMP36 temperature sensor
  int sensorValue = analogRead(tempPin);
  float voltage = sensorValue * (5.0 / 1023.0);
  float temperature = (voltage - 0.5) * 100.0;

  // Adjustable alarm threshold: 15 to 40 degrees C
  int potValue = analogRead(potPin);
  float threshold = map(potValue, 0, 1023, 15, 40);

  // Display readings
  lcd.setCursor(0, 0);
  lcd.print("Temp: ");
  lcd.print(temperature, 1);
  lcd.print((char)223);
  lcd.print("C   ");

  lcd.setCursor(0, 1);
  lcd.print("Limit: ");
  lcd.print(threshold, 0);
  lcd.print((char)223);
  lcd.print("C   ");

  // when temp too high, alarm goes off
  if (temperature >= threshold) {
    digitalWrite(redLED, HIGH);
    digitalWrite(greenLED, LOW);
    tone(buzzer, 1000);
  } else {
    digitalWrite(redLED, LOW);
    digitalWrite(greenLED, HIGH);
    noTone(buzzer);
  }

  // give serial monitor readings 
  Serial.print("Temperature: ");
  Serial.print(temperature);
  Serial.print(" C | Threshold: ");
  Serial.print(threshold);
  Serial.println(" C");

  delay(500);
}
